<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.condor.nexussoft.timeclock</groupId>
        <artifactId>timeclock-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>onboarding</artifactId>
    <name>Nexus Soft Time Clock — Onboarding</name>
    <description>
        Importación masiva de colaboradores (CSV/XLSX). Orquesta, en una sola transacción, los casos
        de uso de Identity (cuenta y roles), HR (perfil) y Scheduling (turno), y consulta el cupo de
        Tenancy. Es el único módulo que depende de otros bounded contexts, y solo de sus puertos de
        entrada.
    </description>

    <dependencies>
        <dependency><groupId>com.condor.nexussoft.timeclock</groupId><artifactId>shared-kernel</artifactId></dependency>
        <dependency><groupId>com.condor.nexussoft.timeclock</groupId><artifactId>platform</artifactId></dependency>
        <dependency><groupId>com.condor.nexussoft.timeclock</groupId><artifactId>identity</artifactId></dependency>
        <dependency><groupId>com.condor.nexussoft.timeclock</groupId><artifactId>tenancy</artifactId></dependency>
        <dependency><groupId>com.condor.nexussoft.timeclock</groupId><artifactId>scheduling</artifactId></dependency>
        <dependency><groupId>com.condor.nexussoft.timeclock</groupId><artifactId>hr</artifactId></dependency>

        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-oauth2-resource-server</artifactId></dependency>
        <dependency><groupId>org.springframework.security</groupId><artifactId>spring-security-oauth2-jose</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>

        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>
