# =========================
# Nexus Soft Time Clock — .gitignore raíz
# =========================

# --- Secretos / entorno ---
.env
infra/.env
scripts/.env
*.local

# --- Backend (Java/Maven) ---
backend/**/target/
*.class
*.jar
!**/.mvn/wrapper/maven-wrapper.jar

# --- Web (Angular/Node) ---
web/node_modules/
web/dist/
web/.angular/
web/coverage/

# --- Mobile (Flutter) ---
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins*
mobile/**/*.g.dart

# --- Infra / datos locales ---
*.pid

# --- IDE / OS ---
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
mocks/

# Certificados TLS: el stack los toma del host (o de infra/nginx/certs en desarrollo).
# Una llave privada no entra nunca al repositorio.
*.pem
*.key
*.crt
*.p12
