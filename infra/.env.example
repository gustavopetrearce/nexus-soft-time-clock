# Copia a infra/.env y ajusta. NO subir .env con secretos reales al repositorio.

# --- Base de datos ---
DB_NAME=nexus
DB_USER=nexus
DB_PASSWORD=nexus

# --- MinIO (evidencias fotográficas, RF-18) ---
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
STORAGE_MINIO_BUCKET=evidence
# Origen por el que el CLIENTE alcanza MinIO. Es el que se usa para firmar las URLs de subida:
# SigV4 firma el Host, así que si no coincide con el que usa el cliente, MinIO devuelve
# SignatureDoesNotMatch. En dev el móvil/navegador va directo a MinIO; en producción, vía NGINX.
STORAGE_MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# Llave del KMS embebido: habilita el cifrado en reposo del bucket (SSE-S3, RNF-08).
# Genera la tuya con:  openssl rand -base64 32
MINIO_KMS_SECRET_KEY=nexus-evidence:dvm3hSV4ldi0rS4Ui6PUyQP9m/4yoWBUcQciYY4Im3Y=

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- Backend (perfil dev usa estos por defecto) ---
SERVER_PORT=8080
LOG_LEVEL_APP=DEBUG

# --- Seguridad ---
# OJO: este fichero alimenta el stack de DESARROLLO (docker-compose.yml), y ese stack NO declara
# ninguna SECURITY_* en el bloque `environment:` del backend. Compose solo sustituye ${...}: una
# variable que el servicio no declara jamás llega al contenedor, así que rellenarlas aquí no
# cambia nada en dev. Se listan porque su ausencia despista, no porque haya que ponerlas.
#
# Su sitio real es el stack productivo (infra/portainer-stack.yml, que sí las declara) o
# scripts/.env si redespliegas con scripts/redeploy.sh. Tabla canónica de variables y qué es
# obligatorio: docs/iteracion-13-produccion/07-despliegue-portainer.md §3.

# Secreto HMAC con el que se firma el QR (ADR-006). OBLIGATORIO en producción: el stack usa
# ${SECURITY_QR_SECRET:?...} y no arranca sin él. En dev no se inyecta y el backend cae al valor
# por defecto de HmacQrTokenSigner, que es público y solo sirve para desarrollo.
# Genera el tuyo con:  openssl rand -base64 32
# CUIDADO AL CAMBIARLO: la firma no lleva identificador de llave, así que el secreto nuevo
# invalida de golpe TODOS los QR ya emitidos (INVALID_QR). Hay que regenerarlos y reimprimirlos
# centro por centro, en una ventana coordinada. Si redespliegas con GitHub Actions, el secret
# SECURITY_QR_SECRET debe valer EXACTAMENTE lo mismo que ya tiene el stack: Portainer reemplaza
# el array de variables completo en cada redespliegue, no lo fusiona.
# SECURITY_QR_SECRET=

# Par RSA de firma del JWT (RS256). Sin él, RsaKeyConfig genera una llave en memoria al arrancar
# y todas las sesiones caen en cada reinicio (el móvil pierde el acceso). PEM en una sola línea
# con "\n" literales; el backend los normaliza. Generarlo una vez:
#   openssl genpkey -algorithm RSA -pkcs8 -out jwt-private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# SECURITY_JWT_PRIVATE_KEY=
# SECURITY_JWT_PUBLIC_KEY=
# SECURITY_JWT_KEY_ID=nexus-rsa
# SECURITY_JWT_ACCESS_TTL_SECONDS=900
# SECURITY_JWT_REFRESH_TTL_DAYS=30

# Credencial con la que Prometheus scrapea /actuator/prometheus. El endpoint dejó de ser público
# (exponía volumen de marcaciones, topología y memoria del servidor) y NGINX ya no publica
# /actuator salvo el health. Sin contraseña el endpoint queda CERRADO: se pierde la métrica, no
# la privacidad. En el stack de desarrollo el perfil dev cae a "prometheus-dev", que es el valor
# que lleva infra/prometheus/prometheus.yml.
# SECURITY_METRICS_USERNAME=prometheus
# SECURITY_METRICS_PASSWORD=

# --- TLS (RNF-05, RN-42) ---
# El NGINX del stack sirve HTTPS en cuanto encuentra certificados legibles en las rutas de abajo
# (dentro del contenedor); si no los encuentra, arranca en HTTP y lo avisa por log. Al activarse,
# el puerto HTTP pasa a redirigir con 301 y se añade HSTS de un año.
#
# TLS_CERTS_DIR es el directorio DEL HOST que se monta en /etc/nginx/certs. Con Let's Encrypt:
#   TLS_CERTS_DIR=/etc/letsencrypt/live/asistencia.tudominio.com
#   TLS_CERT_FILE=/etc/nginx/certs/fullchain.pem
#   TLS_KEY_FILE=/etc/nginx/certs/privkey.pem
# Emisión y renovación (webroot, sin parar el stack):
#   certbot certonly --webroot -w /var/www/certbot -d asistencia.tudominio.com
# Tras renovar hay que recargar NGINX para que tome el certificado nuevo:
#   docker exec <contenedor-nginx> nginx -s reload
#
# Y recuerda que PUBLIC_BASE_URL debe pasar a https://…: con él se firman las URLs de MinIO,
# y una firma emitida contra http:// fallará como SignatureDoesNotMatch al servirse por https.
# TLS_CERTS_DIR=/etc/letsencrypt
# CERTBOT_WEBROOT=/var/www/certbot
# TLS_CERT_FILE=/etc/nginx/certs/fullchain.pem
# TLS_KEY_FILE=/etc/nginx/certs/privkey.pem
# HTTPS_PORT=443   # déjalo en el estándar: la redirección desde HTTP no puede llevar puerto
