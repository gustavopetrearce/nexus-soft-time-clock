# =====================================================================
# Config para scripts/redeploy.sh — Nexus Soft Time Clock
# Copia a scripts/.env y rellena. scripts/.env está en .gitignore: NO subir.
#   cp scripts/.env.example scripts/.env
# =====================================================================

# --- Portainer ---
PORTAINER_URL=https://85.239.240.43:9443
PORTAINER_USER=Admon_dev
PORTAINER_PASS=              # contraseña de Portainer  (obligatorio)
STACK_ID=72
ENDPOINT_ID=2

# --- Repositorio git privado (para que Portainer lo clone) ---
GH_USER=Dem0776
GH_PAT=                      # Personal Access Token de GitHub  (obligatorio)
GIT_REF=refs/heads/main

# --- Secretos del stack (deben COINCIDIR con los ya desplegados) ---
DB_PASSWORD=                 # (obligatorio)  ver Stack → Environment variables en Portainer
SECURITY_QR_SECRET=          # (obligatorio)
# Par RSA de firma del JWT (obligatorio). Portainer REEMPLAZA la env del stack en cada
# redespliegue, así que si no viajan aquí se pierden: el backend regeneraría la llave en
# memoria y caerían todas las sesiones del móvil. Cópialos de Portainer → Stacks →
# nexus-time-clock → Environment variables, en UNA línea con "\n" literales (también se
# acepta el PEM en varias líneas, entre comillas: el script lo convierte).
SECURITY_JWT_PRIVATE_KEY=
SECURITY_JWT_PUBLIC_KEY=
SECURITY_JWT_KEY_ID=nexus-rsa
MINIO_PASSWORD=              # (obligatorio)  credencial del storage de evidencias
MINIO_USER=minioadmin
# Habilita el cifrado en reposo de las evidencias (SSE-S3). El formato es nombre:base64 y la
# clave debe decodificar a 32 bytes EXACTOS; con cualquier otra cosa MinIO muere al arrancar y
# se cae el stack entero. Genérala con:  echo "nexus-evidence:$(openssl rand -base64 32)"
# Déjala vacía para desplegar sin cifrado: el bucket queda SIN cifrar y el backend lo avisa.
MINIO_KMS_SECRET_KEY=
STORAGE_MINIO_BUCKET=evidence

# --- Parámetros de la app ---
DB_NAME=nexus
DB_USER=nexus
HTTP_PORT=8088
# Puerto HTTPS. Un puerto alto por defecto: si algo ya ocupa el 443 del host, NGINX no arranca
# y tumba el stack. Ponerlo en 443 SOLO cuando el certificado esté emitido y el puerto libre.
HTTPS_PORT=8443
# Certificados del host. Mientras el directorio no tenga fullchain.pem/privkey.pem legibles,
# NGINX sirve HTTP y lo avisa por log: no hay que tocar nada para seguir como hasta ahora.
TLS_CERTS_DIR=/etc/letsencrypt
CERTBOT_WEBROOT=/var/www/certbot
# Credencial del scrape de métricas (/actuator/prometheus ya no es público).
# Vacía = endpoint cerrado. Generar con: openssl rand -base64 24
SECURITY_METRICS_USERNAME=prometheus
SECURITY_METRICS_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
LOG_LEVEL_APP=INFO

# Origen público del stack: con él se firman las URLs de subida de evidencias, así que debe ser
# EXACTAMENTE el que usan el portal y la app (incluido el puerto). Por defecto toma APP_URL.
PUBLIC_BASE_URL=http://85.239.240.43:8088

# --- Verificación post-deploy ---
APP_URL=http://85.239.240.43:8088
VERIFY_EMAIL=admin@demo.com
VERIFY_PASSWORD=Admin123!
